# mock = genera alertas de ejemplo (Suricata + Wazuh) sin necesitar nada real
# live = consulta el Wazuh Indexer (OpenSearch) de verdad
MODE=mock

PORT=4000

# --- Wazuh Indexer (OpenSearch) — de aquí salen las alertas. Sólo hacen falta si MODE=live ---
WAZUH_INDEXER_HOST=https://192.168.0.22:9200
WAZUH_INDEXER_USER=admin
WAZUH_INDEXER_PASS=changeme
# true si usas el certificado autofirmado por defecto del Indexer
WAZUH_INDEXER_INSECURE=true

# Nombre del índice (patrón) donde Wazuh guarda las alertas
WAZUH_ALERTS_INDEX=wazuh-alerts-*

# --- Wazuh Manager API (puerto 55000 por defecto) — de aquí sale el listado real de
# agentes registrados (nombre, IP, SO, estado de conexión). Opcional: si no la
# configuras, la vista de Agentes se rellena sólo con los agentes que aparecen en
# las alertas (puede ser un nº menor que tus agentes reales si alguno lleva un
# rato sin generar alertas). Usuario recomendado: uno de sólo lectura.
WAZUH_API_HOST=https://192.168.0.22:55000
WAZUH_API_USER=wazuh-wui
WAZUH_API_PASS=changeme
WAZUH_API_INSECURE=true

# Nota: la configuración del bot de Telegram (token, chat ID, severidad mínima
# a notificar) NO se pone aquí — se configura desde el propio panel, en la
# pestaña "Ajustes", y se guarda en backend/data/settings.json (fuera de git).
