# mock = genera alertas de ejemplo (Suricata + Wazuh) sin necesitar nada real
# live = consulta el Wazuh Indexer (OpenSearch) de verdad
MODE=mock

PORT=4000

# --- Wazuh Indexer (OpenSearch) — de aquí salen las alertas. Sólo hacen falta si MODE=live ---
# WAZUH_INDEXER_HOST: IP o dominio de tu Wazuh Indexer, puerto 9200 (https)
WAZUH_INDEXER_HOST=https://TU_IP_DEL_INDEXER:9200
# Usuario y contraseña de tu Wazuh Indexer (por defecto el usuario suele ser "admin")
WAZUH_INDEXER_USER=TU_USUARIO_INDEXER
WAZUH_INDEXER_PASS=TU_PASSWORD_INDEXER
# true si usas el certificado autofirmado por defecto del Indexer
WAZUH_INDEXER_INSECURE=true

# Nombre del índice (patrón) donde Wazuh guarda las alertas — normalmente no hace falta tocarlo
WAZUH_ALERTS_INDEX=wazuh-alerts-*

# --- Wazuh Manager API (puerto 55000 por defecto) — de aquí sale el listado real de
# agentes registrados (nombre, IP, SO, estado de conexión). Opcional: si no la
# configuras, la vista de Agentes se rellena sólo con los agentes que aparecen en
# las alertas (puede ser un nº menor que tus agentes reales si alguno lleva un
# rato sin generar alertas). Usuario recomendado: uno de sólo lectura.
# WAZUH_API_HOST: IP o dominio de tu Wazuh Manager, puerto 55000 (https)
WAZUH_API_HOST=https://TU_IP_DEL_MANAGER:55000
# Usuario y contraseña de la API del Manager (por defecto suele ser "wazuh-wui")
WAZUH_API_USER=TU_USUARIO_API
WAZUH_API_PASS=TU_PASSWORD_API
WAZUH_API_INSECURE=true

# Nota: la configuración del bot de Telegram (token, chat ID, severidad mínima
# a notificar) y la API key de Gemini (para el análisis con IA) NO se ponen aquí
# — se configuran desde el propio panel, en la pestaña "Ajustes", y se guardan
# en backend/data/settings.json (fuera de git).
